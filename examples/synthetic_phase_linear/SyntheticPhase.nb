Cell["Uncertainty", "Section",
 CellChangeTimes->{{3.9808374782451982`*^9, 
  3.9808374806250353`*^9}},ExpressionUUID->"5797a99b-d2b3-45aa-a1e5-\
0ed7ac234fad"],

Cell[CellGroupData[{

Cell["Prior Information Matrix", "Subsection",
 CellChangeTimes->{{3.98086954067671*^9, 
  3.9808695448026533`*^9}},ExpressionUUID->"511ddfda-6b4c-4fee-8a54-\
78e2c36176cd"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[ScriptCapitalI]", "prior"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       SubsuperscriptBox["\[Del]", "\[Lambda]", "2"], "ln"}]}], " ", 
     RowBox[{"p", "(", "\[Lambda]", ")"}]}], 
    SubscriptBox["|", 
     OverscriptBox["\[Lambda]", "^"]]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"f1c351f7-6a46-4f66-ab5a-c029a53d5e43"]], \
"Text",
 CellChangeTimes->{{3.980869547444097*^9, 3.980869597198735*^9}, {
  3.980870103327463*^9, 
  3.980870106095196*^9}},ExpressionUUID->"2025d2a2-3b84-45b3-96fc-\
1cf5502250db"],

Cell[TextData[{
 "The log prior is \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"ln", " ", 
     RowBox[{"p", "(", "\[Lambda]", ")"}]}], "=", 
    RowBox[{"constant", "-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Omega]", "-", 
         SubscriptBox["\[Mu]", "\[Omega]"]}], ")"}], "2"], 
      RowBox[{"2", 
