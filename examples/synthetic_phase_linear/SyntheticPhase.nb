Cell[CellGroupData[{

Cell[TextData[{
 "Over ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "615f9c6a-de72-4790-8954-d67c1cf62999"],
 " (exact)"
}], "Subsubsection",
 CellChangeTimes->{{3.9806932348449383`*^9, 
  3.9806932427186823`*^9}},ExpressionUUID->"d5a7a5d1-d0ec-4918-b434-\
963a32574a85"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "R"], "Q"}], "=", 
    RowBox[{"0", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Alpha]", "R"], "+", "1"}], 
        RowBox[{" ", "R"}]]}], "+", 
      FractionBox[
       SubscriptBox["\[Beta]", "R"], 
       SuperscriptBox["R", "2"]], "-", 
      FractionBox["N", 
       RowBox[{"2", " ", "R"}]], "+", 
      FractionBox[
       SubscriptBox["S", "1"], 
       RowBox[{"2", " ", 
        SuperscriptBox["R", "2"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "f4cb07de-6b08-4f17-a970-420b03083360"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "R"], "Q"}], "=", 
    RowBox[{"0", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{" ", "R"}]]}], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Alpha]", "R"], "+", "1", "+", 
         FractionBox["N", "2"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{" ", 
         SuperscriptBox["R", "2"]}]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Beta]", "R"], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          SubscriptBox["S", "1"]}]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"9b074ed2-c84c-440e-a351-21b583986ce0"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    FractionBox[
     RowBox[{
      RowBox[{"2", 
       SubscriptBox["\[Beta]", "R"]}], "+", "S"}], 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Alpha]", "R"], "+", "1"}], ")"}]}], "+", "N"}]]}], 
   TraditionalForm]],ExpressionUUID->"7d3a4bd3-5206-4751-b7a9-19861be36d24"],
 "\nwith ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "N"], 
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["y", "k"], "-", 
          SubscriptBox[
           OverscriptBox["\[Theta]", "^"], "k"]}], ")"}], "2"], "+", 
       SubscriptBox["\[CapitalSigma]", 
        RowBox[{"k", ",", "k"}]]}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"2000013c-54cc-4e53-a0c0-e2c0be88441e"]
}], "Text",
 CellChangeTimes->{{3.980693247346827*^9, 3.980693470707555*^9}, {
  3.9806935022420597`*^9, 3.980693618889565*^9}, {3.980694589033964*^9, 
  3.980694590197112*^9}, {3.9806946220856647`*^9, 3.980694622085882*^9}, {
  3.980708147613186*^9, 
  3.9807081555628433`*^9}},ExpressionUUID->"b6ad1631-bbf3-4b53-8a52-\
9d442e4439ac"],

Cell[TextData[{
 "Ignorance prior:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"N", "+", "2"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "N"], 
      RowBox[{"[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["y", "k"], "-", 
           SubscriptBox[
            OverscriptBox["\[Theta]", "^"], "k"]}], ")"}], "2"], "+", 
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"k", ",", "k"}]]}], "]"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bbd2c763-286b-481a-8256-598e1dbfb3cb"]
}], "Text",
 CellChangeTimes->{
  3.980708955938438*^9, {3.980709249080858*^9, 
   3.980709265992811*^9}},ExpressionUUID->"b4cfb7e8-1a6b-439a-adce-\
bf0132e8f945"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

