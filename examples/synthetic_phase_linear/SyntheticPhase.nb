    RowBox[{
     FractionBox["12", 
      SuperscriptBox["N", "3"]], 
     FractionBox[
      RowBox[{
       OverscriptBox["R", "_"], " "}], 
      SubsuperscriptBox[
       RowBox[{
        OverscriptBox["\[CapitalDelta]t", "_"], " "}], "min", "2"]]}], 
    "\[TildeTilde]", 
