Cell[TextData[{
 "We can simplify by noting that \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"k", "|", 
      RowBox[{"k", "-", "1"}]}]], "=", 
    RowBox[{
     SubscriptBox["P", 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]], "+", 
     RowBox[{"2", 
      SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb5704aa-db49-4d39-9a86-52b72913c184"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      RowBox[{"k", "|", 
       RowBox[{"k", "-", "1"}]}]], "-", 
     SubscriptBox["P", 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]]}], "=", 
    RowBox[{"2", 
     SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "ce8b6ca1-1303-48c6-8937-3f79eda6155e"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"mean", "=", 
    FractionBox[
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Theta]", "k"], "-", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], " ", ")"}]}], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t", " ", 
       SubscriptBox[
        OverscriptBox["\[Theta]", "^"], 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}]]}]}], 
     RowBox[{
      SubscriptBox["P", 
       RowBox[{
        RowBox[{"k", "-", "1"}], "|", 
        RowBox[{"k", "-", "1"}]}]], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]}]]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea7792b5-016d-4f54-89a7-1c4c693ecfc2"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    FractionBox[
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Theta]", "k"], "-", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], " ", ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["P", 
          RowBox[{"k", "|", 
           RowBox[{"k", "-", "1"}]}]], "-", 
         SubscriptBox["P", 
          RowBox[{
           RowBox[{"k", "-", "1"}], "|", 
           RowBox[{"k", "-", "1"}]}]]}], ")"}], " ", 
       SubscriptBox[
        OverscriptBox["\[Theta]", "^"], 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}]]}]}], 
     SubscriptBox["P", 
      RowBox[{"k", "|", 
       RowBox[{"k", "-", "1"}]}]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca32eac6-8e24-4128-a2da-3a49b6e395f1"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[Theta]", "^"], 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["P", 
         RowBox[{
          RowBox[{"k", "-", "1"}], "|", 
          RowBox[{"k", "-", "1"}]}]], " "}], 
       SubscriptBox["P", 
        RowBox[{"k", "|", 
         RowBox[{"k", "-", "1"}]}]]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "k"], "-", 
        SubscriptBox[
         OverscriptBox["\[Theta]", "^"], 
         RowBox[{
          RowBox[{"k", "-", "1"}], "|", 
          RowBox[{"k", "-", "1"}]}]], "-", 
        RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], " ", ")"}]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dc305ae8-e65c-4d97-b137-2447f0725c43"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[Theta]", "^"], 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]], "+", 
     RowBox[{
      SubscriptBox["J", 
       RowBox[{"k", "-", "1"}]], "(", 
      RowBox[{
       SubscriptBox["\[Theta]", "k"], "-", 
       SubscriptBox[
        OverscriptBox["\[Theta]", "^"], 
        RowBox[{"k", "|", 
         RowBox[{"k", "-", "1"}]}]]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "add947d8-2a7c-40b1-b307-6c3dcd76186b"],
 "\n\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", 
     RowBox[{"k", "-", "1"}]], "=", 
    RowBox[{
     SubscriptBox["P", 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]], 
     SubsuperscriptBox["P", 
      RowBox[{"k", "|", 
       RowBox[{"k", "-", "1"}]}], 
      RowBox[{"-", "1"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "11e58e69-33e6-4b94-af98-5d68cd8ab5f1"]
}], "Text",
 CellChangeTimes->{{3.98093984473036*^9, 3.98093993698037*^9}, {
  3.9809399698633738`*^9, 3.980940135226121*^9}, {3.980940198692718*^9, 
  3.980940207984433*^9}, {3.9809402977965517`*^9, 3.9809403047274237`*^9}, {
  3.980940383258768*^9, 
  3.98094038569237*^9}},ExpressionUUID->"c788a7c3-ecb3-4a39-b2b7-\
a3abf0739486"],

Cell[TextData[{
 "The variance can be transformed using the ",
 ButtonBox["Woodbury matrix identity",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Woodbury_matrix_identity"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Woodbury_matrix_identity"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"variance", "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"[", 
       RowBox[{
        SubsuperscriptBox["P", 
         RowBox[{
          RowBox[{"k", "-", "1"}], "|", 
          RowBox[{"k", "-", "1"}]}], 
         RowBox[{"-", "1"}]], "+", 
        SuperscriptBox["Q", 
         RowBox[{"-", "1"}]]}], "]"}], 
      RowBox[{"-", "1"}]], "=", 
     RowBox[{
      SubscriptBox["P", 
       RowBox[{
        RowBox[{"k", "-", "1"}], "|", 
        RowBox[{"k", "-", "1"}]}]], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{
         SubscriptBox["P", 
          RowBox[{
           RowBox[{"k", "-", "1"}], "|", 
           RowBox[{"k", "-", "1"}]}]], "(", 
         RowBox[{"Q", "+", 
          SubscriptBox["P", 
           RowBox[{
            RowBox[{"k", "-", "1"}], "|", 
            RowBox[{"k", "-", "1"}]}]]}], ")"}], 
        RowBox[{"-", "1"}]], 
       SubscriptBox["P", 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}]]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f023a4ab-0f21-49eb-b5b5-4d5fc8a224d9"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox["P", 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]], "-", 
     RowBox[{
      SubscriptBox["P", 
       RowBox[{
        RowBox[{"k", "-", "1"}], "|", 
        RowBox[{"k", "-", "1"}]}]], 
      SubsuperscriptBox["P", 
       RowBox[{"k", "|", 
        RowBox[{"k", "-", "1"}]}], 
       RowBox[{"-", "1"}]], 
      SubscriptBox["P", 
       RowBox[{
        RowBox[{"k", "-", "1"}], "|", 
        RowBox[{"k", "-", "1"}]}]]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84b30839-5491-48ac-8df7-d2627ec16d3f"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox["P", 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]], "-", 
     RowBox[{
      SubscriptBox["J", 
       RowBox[{"k", "-", "1"}]], 
      SubscriptBox["P", 
       RowBox[{"k", "|", 
        RowBox[{"k", "-", "1"}]}]], 
      SubsuperscriptBox["J", 
       RowBox[{"k", "-", "1"}], "T"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5169e2cc-5634-4888-a2dd-3f6b13fdc709"],
 "\n\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "=", 
    RowBox[{"2", " ", 
     SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c4dfe22-087b-4ee7-9e1a-6a05943bff99"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["J", 
     RowBox[{"k", "-", "1"}], "T"], "=", 
    RowBox[{
     SubsuperscriptBox["P", 
      RowBox[{"k", "|", 
       RowBox[{"k", "-", "1"}]}], 
      RowBox[{"-", "1"}]], 
     SubscriptBox["P", 
      RowBox[{
       RowBox[{"k", "-", "1"}], "|", 
       RowBox[{"k", "-", "1"}]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cecef5bd-bb18-4d47-87bb-57d4e786dc96"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     RowBox[{
      RowBox[{"k", "-", "1"}], "|", 
      RowBox[{"k", "-", "1"}]}]], "=", 
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"k", "-", "1"}]], 
     SubscriptBox["P", 
      RowBox[{"k", "|", 
       RowBox[{"k", "-", "1"}]}]]}]}], TraditionalForm]],ExpressionUUID->
  "f9d1815f-8b36-49f0-b75a-7a0d21b3ccd1"],
 "\n\n"
}], "Text",
 CellChangeTimes->{{3.980940325608663*^9, 3.98094033506431*^9}, {
  3.980940366494812*^9, 3.980940377273629*^9}, {3.980940560939198*^9, 
  3.980940728734585*^9}, {3.980940824676496*^9, 
  3.9809409148568497`*^9}},ExpressionUUID->"10c6443d-8e77-4bb3-8489-\
9fed9e0d4849"]
}, Open  ]],

