   3.981023860684043*^9},ExpressionUUID->"b9cfbcaa-3d5a-42bd-abe5-\
feb1573875ff"],

Cell[TextData[{
 "We can make the approximation that \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Var", "(", "\[Omega]", ")"}], "\[TildeTilde]", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"]}], "\[ScriptCapitalT]"], "+", 
     FractionBox[
      RowBox[{"12", " ", "R", " ", "\[CapitalDelta]t"}], 
      SuperscriptBox["\[ScriptCapitalT]", "3"]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "63e6137c-9962-4928-b4cc-08793f0d2690"],
 "\n\t\nIn dimensionless form\n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"Var", "(", "\[Omega]", ")"}], 
      SuperscriptBox["\[Omega]", "2"]], "\[TildeTilde]", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SubscriptBox["D", "\[Theta]"]}], 
       RowBox[{"\[Omega]", " ", 
        RowBox[{"(", 
         RowBox[{"\[Omega]", " ", "\[ScriptCapitalT]"}], ")"}]}]], "+", 
      FractionBox[
       RowBox[{"12", " ", "R", " ", "\[CapitalDelta]t"}], 
       RowBox[{
        SuperscriptBox["\[Omega]", "2"], 
        SuperscriptBox["\[ScriptCapitalT]", "3"]}]]}]}], "=", 
    RowBox[{
     FractionBox["2", "Pe"], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        FractionBox[
         RowBox[{" ", "R"}], 
         RowBox[{" ", 
          RowBox[{"2", 
           SubscriptBox["D", "\[Theta]"], " ", "\[ScriptCapitalT]"}]}]], 
        FractionBox["12", 
         RowBox[{" ", "N"}]]}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5cc640f0-be1c-43ab-a09f-45be99b52150"],
 "\n\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Pe", " ", "=", 
    RowBox[{
     RowBox[{"\[Omega]", "(", 
      RowBox[{"\[Omega]", " ", "\[ScriptCapitalT]"}], ")"}], "/", 
     SubscriptBox["D", "\[Theta]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "415c2503-b370-4c01-b51a-05add5c12c7a"],
 "."
}], "Text",
