Cell[TextData[{
 "Consider the case of an ignorance prior ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Omega]"], "\[RightArrow]", "\[Infinity]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b34b93f5-7800-4474-b702-29db8c702eaf"],
