Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      SubscriptBox["\[Theta]", "j"]], "L"}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Theta]", "k"], "-", 
          SubscriptBox[
           OverscriptBox["\[Theta]", "^"], 
           RowBox[{"k", "|", "N"}]]}], ")"}], 
        SubscriptBox["\[Delta]", 
         RowBox[{"j", ",", "k"}]]}], 
