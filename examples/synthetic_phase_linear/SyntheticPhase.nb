          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "\[CapitalDelta]t", 
           " ", 
           SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}]}], 
    RowBox[{"4", " ", "\[CapitalDelta]t"}]]}], "}"}]], "Output",
