Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"L", "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Theta]", "k"], "-", 
         SubscriptBox[
          OverscriptBox["\[Theta]", "^"], 
          RowBox[{"k", "|", "N"}]]}], ")"}], "2"], 
      RowBox[{"2", 
       SubscriptBox["P", 
        RowBox[{"k", "|", "N"}]]}]]}], "-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "k"], "-", 
        SubscriptBox["\[Theta]", 
         RowBox[{"k", "-", "1"}]], "-", 
        RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], "2"], 
     RowBox[{"4", " ", 
      SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]], "-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", 
         RowBox[{"k", "-", "1"}]], "-", 
        SubscriptBox[
         OverscriptBox["\[Theta]", "^"], 
         RowBox[{
          RowBox[{"k", "-", "1"}], "|", 
          RowBox[{"k", "-", "1"}]}]]}], ")"}], "2"], 
     RowBox[{"2", " ", 
      SubscriptBox["P", 
       RowBox[{
        RowBox[{"k", "-", "1"}], "|", 
        RowBox[{"k", "-", "1"}]}]]}]], "+", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "k"], "-", 
        SubscriptBox[
         OverscriptBox["\[Theta]", "^"], 
         RowBox[{"k", "|", 
          RowBox[{"k", "-", "1"}]}]]}], ")"}], "2"], 
     RowBox[{"2", " ", 
      SubscriptBox["P", 
       RowBox[{"k", "|", 
        RowBox[{"k", "-", "1"}]}]]}]]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"6b5add60-1451-417d-a3c2-9a9ad807a8fb"]], \
"Text",
