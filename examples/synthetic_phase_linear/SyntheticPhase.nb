e089d4b6c133"],

Cell[TextData[{
 "For small ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalDelta]t", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "747dfe30-c90a-46d7-9fe8-8669ee0f4093"],
 ", the noise contribution dominates. Let\[CloseCurlyQuote]s limit the scaled \
variance to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Var", "(", "\[Omega]", ")"}], "/", 
     SuperscriptBox["\[Omega]", "2"]}], "=", 
