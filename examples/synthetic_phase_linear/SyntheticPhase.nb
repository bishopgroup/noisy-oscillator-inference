   RowBox[{"NormalDistribution", "[", 
    RowBox[{
     RowBox[{"\[Theta]km1", "+", 
      RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ",", 
     SqrtBox[
      RowBox[{"2", "D\[Theta]", " ", "\[CapitalDelta]t"}]]}], "]"}], "]"}], 
  "[", "\[Theta]k", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PDF", "[", 
