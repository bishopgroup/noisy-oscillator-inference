     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}], 
       SubscriptBox["S", "0"]}], "-", 
      SubsuperscriptBox["S", "1", "2"]}], 
     RowBox[{"2", " ", 
      RowBox[{"\[CapitalDelta]t", "(", 
       RowBox[{"1", "+", "N"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"N", "-", "1"}], ")"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c385fc5f-9246-414c-9ccc-e1e3936c74c9"]
}], "Text",
