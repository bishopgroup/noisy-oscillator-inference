Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["\[Theta]", "0"]], 
       SubscriptBox["\[ScriptL]", "c"]}], 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["D", "\[Theta]"]], 
       SubscriptBox["\[ScriptL]", "c"]}]}], "]"}], "=", 
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Theta]", "0"], "-", 
            SubscriptBox["\[Mu]", "\[Theta]"]}], ")"}], 
          SubsuperscriptBox["\[Sigma]", "\[Theta]", "2"]]}], "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", " ", 
           SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Theta]", "1"], "-", 
           SubscriptBox["\[Theta]", "0"], "-", 
           RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}]}]}], ")"}], 
      
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           SubscriptBox["\[Alpha]", "D"], "+", "1"}], 
          SubscriptBox["D", "\[Theta]"]]}], "+", 
        FractionBox[
         SubscriptBox["\[Beta]", "D"], 
         SubsuperscriptBox["D", "\[Theta]", "2"]], "-", 
        FractionBox["N", 
         RowBox[{"2", " ", 
          SubscriptBox["D", "\[Theta]"]}]], "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"4", " ", 
           SubsuperscriptBox["D", "\[Theta]", "2"], " ", 
           "\[CapitalDelta]t"}]], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Theta]", "1"], "-", 
            SubscriptBox["\[Theta]", "0"], "-", 
            RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], "2"]}], 
        "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"4", "  ", 
           SubsuperscriptBox["D", "\[Theta]", "2"], " ", 
           "\[CapitalDelta]t"}]], "[", 
         RowBox[{
          SubscriptBox["S", "0"], "-", 
          RowBox[{"2", 
           RowBox[{
            SubscriptBox["S", "1"], "(", 
            RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}]}], " ", "+", 
          
          RowBox[{
           RowBox[{"(", 
            RowBox[{"N", "-", "1"}], ")"}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"\[Omega]", "  ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
         "]"}]}], ")"}]}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "6470c542-fc8e-41de-908a-1e2556c22449"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      SubscriptBox["\[Theta]", "1"], 
      SubscriptBox["S", "0"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[DoubleStruckCapitalE]", "[", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "2"}], "N"], 
       SuperscriptBox[
        RowBox[{
         SubscriptBox["\[Theta]", "1"], "(", 
         RowBox[{
          SubscriptBox["\[Theta]", "k"], "-", 
          SubscriptBox["\[Theta]", 
           RowBox[{"k", "-", "1"}]]}], ")"}], "2"]}], "]"}], "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "2"}], "N"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"1", ",", "k"}]], "-", 
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"1", ",", 
          RowBox[{"k", "-", "1"}]}]]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"50ce6152-2dbb-46ab-80a0-8ebde393d514"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Cov", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["\[Theta]", "0"]], 
       SubscriptBox["\[ScriptL]", "c"]}], ",", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["D", "\[Theta]"]], 
       SubscriptBox["\[ScriptL]", "c"]}]}], ")"}], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       RowBox[{"1", ",", "1"}]], 
      RowBox[{"4", 
       SubsuperscriptBox["D", "\[Theta]", "2"], " ", "\[CapitalDelta]t"}]], 
     "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", 
        SubsuperscriptBox["D", "\[Theta]", "2"], "  ", "\[CapitalDelta]t"}]], 
      
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "2"}], "N"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", 
          RowBox[{"1", ",", "k"}]], "-", 
         SubscriptBox["\[CapitalSigma]", 
          RowBox[{"1", ",", 
           RowBox[{"k", "-", "1"}]}]]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"57387ad4-62b6-46b4-ab46-b18afe14ebc7"],
 "\n"
}], "Text",
