   RowBox[{"{", 
    RowBox[{"\[Omega]", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.980969014262039*^9, 3.980969024501042*^9}, {
  3.981197734238327*^9, 3.981197746955288*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"6e4a47db-221e-4ad3-8058-b165b36fcacf"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"S0", "-", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"S1", " ", "\[CapitalDelta]t"}], ")"}], " ", "\[Omega]"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
    SuperscriptBox["\[CapitalDelta]t", "2"], " ", 
    SuperscriptBox["\[Omega]", "2"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Omega]", "]"}], "3"],
    SeriesData[$CellContext`\[Omega], 0, {}, 0, 3, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Omega], 
   0, {$CellContext`S0, (-2) $CellContext`S1 $CellContext`\[CapitalDelta]t, \
(-1 + $CellContext`n) $CellContext`\[CapitalDelta]t^2}, 0, 3, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.980969020080061*^9, 3.980969025038199*^9}, {
  3.9811977348032837`*^9, 3.9811977472160378`*^9}},
 CellLabel->
  "Out[163]=",ExpressionUUID->"259c7ea3-efaa-4711-92b1-b2cde01aa370"]
}, Open  ]],

Cell[TextData[{
 "When I take expectations based on the smoothing distribution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", 
    RowBox[{
     RowBox[{"\[Theta]", "|", "y"}], ",", 
     OverscriptBox["\[Lambda]", "^"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc51dd70-44c7-41f7-bd36-4ecd1127a87b"],
 ", I get\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["S", "^"], "0"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "2"}], "N"], 
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[Theta]", "^"], "k"], "-", 
          SubscriptBox[
           OverscriptBox["\[Theta]", "^"], 
           RowBox[{"k", "-", "1"}]]}], ")"}], "2"], "+", 
       SubscriptBox["\[CapitalSigma]", 
        RowBox[{"k", ",", "k"}]], "+", 
       SubscriptBox["\[CapitalSigma]", 
        RowBox[{
         RowBox[{"k", "-", "1"}], ",", 
         RowBox[{"k", "-", "1"}]}]], "-", 
       RowBox[{"2", 
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"k", ",", 
          RowBox[{"k", "-", "1"}]}]]}]}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"75eae803-a039-4e02-b6d5-1652b61ab746"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["S", "^"], "1"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "2"}], "N"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["\[Theta]", "^"], "k"], "-", 
       SubscriptBox[
        OverscriptBox["\[Theta]", "^"], 
        RowBox[{"k", "-", "1"}]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"c4265575-1457-4500-96f2-67667511a411"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["S", "^"], "y"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "N"], 
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["y", "k"], "-", 
          SubscriptBox[
           OverscriptBox["\[Theta]", "^"], "k"]}], ")"}], "2"], "+", 
       SubscriptBox["\[CapitalSigma]", 
        RowBox[{"k", ",", "k"}]]}], "]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3e7538c4-fb1c-4156-bebd-b1eb55f06783"]
}], "Text",
 CellChangeTimes->{{3.980870559056828*^9, 3.980870690166266*^9}, {
  3.980968942224526*^9, 
  3.98096894252593*^9}},ExpressionUUID->"2b793c54-2cbc-4767-8d8d-\
b9eb310f53c6"]
}, Open  ]],

