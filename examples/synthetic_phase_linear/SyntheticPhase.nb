            RowBox[{"-", "1"}], "+", "n"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "n"}], ")"}], " ", 
         SuperscriptBox["\[CapitalDelta]t", "2"]}], 
        RowBox[{"S0", "-", 
         RowBox[{"n", " ", "S0"}], "+", 
