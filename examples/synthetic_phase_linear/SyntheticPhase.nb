Cell[TextData[{
 "Over ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],ExpressionUUID->
  "ed40815f-b482-425c-87df-c2f6e34e4ebe"]
}], "Subsubsection",
 CellChangeTimes->{{3.9806932348449383`*^9, 3.9806932427186823`*^9}, {
  3.98069443819591*^9, 3.98069444048285*^9}, {3.980707807010891*^9, 
  3.9807078091655188`*^9}, {3.980707907852687*^9, 
  3.9807079087661743`*^9}},ExpressionUUID->"a798b093-8223-4087-88b5-\
75d80f33abfb"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "\[Omega]"], "Q"}], "=", 
   RowBox[{"0", "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"\[Omega]", "-", 
         SubscriptBox["\[Mu]", "\[Omega]"]}], ")"}], 
       SubsuperscriptBox["\[Sigma]", "\[Omega]", "2"]]}], "+", 
     FractionBox[
      SubscriptBox["S", "1"], 
      RowBox[{" ", 
       RowBox[{"2", " ", 
        SubscriptBox["D", "\[Theta]"]}]}]], "-", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}], "\[Omega]", " ", "\[CapitalDelta]t", 
       " "}], 
      RowBox[{"2", 
       SubscriptBox["D", "\[Theta]"], " "}]]}]}]}], 
  TraditionalForm]],ExpressionUUID->"04ead07a-9341-4cd2-b0d8-456673e733c0"]], \
"Text",
 CellChangeTimes->{
  3.9807079209584312`*^9, {3.980707959062264*^9, 3.980708092428379*^9}, {
   3.980708650921178*^9, 3.980708678877029*^9}, {3.980708709289057*^9, 
   3.980708767578644*^9}, {3.980708906949332*^9, 3.9807089546745577`*^9}, {
   3.980710358876536*^9, 3.9807103876065474`*^9}, {3.980710427219515*^9, 
   3.9807104285661373`*^9}, {3.980710464184287*^9, 3.9807105078978367`*^9}, 
   3.980710675386095*^9, {3.981195312473403*^9, 
   3.981195329822999*^9}},ExpressionUUID->"cdb367cc-0a1d-41fd-b154-\
3aae5964ad0d"],

Cell[TextData[{
 "Ignorance prior (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Omega]"], "\[RightArrow]", "\[Infinity]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84b3b509-56f1-4172-9d10-ee7f69b9252c"],
 ")\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], " ", "\[CapitalDelta]t"}]], 
      SubscriptBox["S", "1"]}], "=", 
     FractionBox[
      RowBox[{
       SubscriptBox["\[Theta]", "N"], "-", 
       SubscriptBox["\[Theta]", "1"]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}], " ", "\[CapitalDelta]t"}]]}]}], 
   TraditionalForm]],ExpressionUUID->"6e1e7688-fedc-4d75-b99b-9919dfcfffb5"]
}], "Text",
 CellChangeTimes->{
  3.980708955938438*^9, {3.9811953558703403`*^9, 
   3.981195415305098*^9}},ExpressionUUID->"1173f2d6-ba56-4464-ac7b-\
ec9d2f1d45ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "\[Theta]"], TraditionalForm]],ExpressionUUID->
  "f0ec4a1f-131a-4a14-abd8-9c8f7f67708f"]
}], "Subsubsection",
 CellChangeTimes->{{3.9806932348449383`*^9, 3.9806932427186823`*^9}, {
  3.98069443819591*^9, 
  3.98069444048285*^9}},ExpressionUUID->"c33e2179-8fc2-4136-8bdf-\
88b4135c7b75"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", 
     SubscriptBox["D", "\[Theta]"]], "Q"}], "=", 
   RowBox[{"0", "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SubscriptBox["\[Alpha]", "D"], "+", "1"}], 
       RowBox[{" ", 
        SubscriptBox["D", "\[Theta]"]}]]}], "+", 
     FractionBox[
      SubscriptBox["\[Beta]", "D"], 
      SubsuperscriptBox["D", "\[Theta]", "2"]], "-", 
     FractionBox["N", 
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"]}]], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubsuperscriptBox["D", "\[Theta]", "2"], " ", "\[CapitalDelta]t"}]], 
      "[", 
      RowBox[{
       SubscriptBox["S", "0"], "-", 
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["S", "1"], "(", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}]}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "  ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
      "]"}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"0c0a5046-ce9c-44d5-8525-e45cfab08f6f"]], \
"Text",
 CellChangeTimes->{{3.9807089716408253`*^9, 3.9807090036022*^9}, {
  3.980710534998301*^9, 3.980710669836224*^9}, {3.981195500259*^9, 
  3.981195532834828*^9}},ExpressionUUID->"ef1fcb0c-d13b-4030-87fa-\
068e0579e25a"],

Cell[TextData[{
 "Ignorance prior (",
 Cell[BoxData[
  FormBox[
   FormBox[
    RowBox[{
     SubscriptBox["\[Alpha]", "D"], "\[RightArrow]", "0"}],
    TraditionalForm], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "008e4e20-89dd-4004-bcb0-4bb8edd71bdb"],
 ", ",
 Cell[BoxData[
  FormBox[
   FormBox[
    RowBox[{
     SubscriptBox["\[Beta]", "D"], "\[RightArrow]", "0"}],
    TraditionalForm], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9a12a755-bddb-4452-950d-2ec7c86c23c1"],
 ")\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{" ", 
        SubscriptBox["D", "\[Theta]"]}]]}], "-", 
     FractionBox["N", 
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"]}]], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubsuperscriptBox["D", "\[Theta]", "2"], " ", "\[CapitalDelta]t"}]], 
      "[", 
      RowBox[{
       SubscriptBox["S", "0"], "-", 
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["S", "1"], "(", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}]}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "  ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
      "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "ef617e07-71ab-41ee-906e-3459b04305af"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"N", "+", "2"}], ")"}], " ", "\[CapitalDelta]t"}]], "[", 
     RowBox[{
      SubscriptBox["S", "0"], "-", 
      RowBox[{"2", 
       RowBox[{
        SubscriptBox["S", "1"], "(", 
        RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}]}], " ", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Omega]", "  ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
     "]"}]}], TraditionalForm]],ExpressionUUID->
  "be5e420e-3afd-446d-8c35-a9e9933497c8"]
}], "Text",
 CellChangeTimes->{
  3.980708955938438*^9, {3.980709043748221*^9, 3.980709074210299*^9}, {
   3.980709176274665*^9, 3.980709192457053*^9}, {3.981195539274519*^9, 
   3.9811955426973658`*^9}, {3.9811956038274727`*^9, 3.981195627404731*^9}, {
   3.981195659003478*^9, 
