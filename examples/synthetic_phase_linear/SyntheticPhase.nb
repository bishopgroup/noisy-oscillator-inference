Cell[TextData[{
 "The ",
 StyleBox["mean",
  FontWeight->"Bold"],
 " of the desired distribution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Theta]", 
      RowBox[{"k", "-", "1"}]], "|", 
     SubscriptBox["\[Theta]", "k"]}], ",", 
    SubscriptBox["y", 
     RowBox[{"1", ":", "N"}]], ",", "\[Lambda]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f7d08a1-dfe6-46be-82d4-568967f556d4"],
 " is\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"mean", "=", 
    FractionBox[
     RowBox[{
      RowBox[{
       SubscriptBox["P", 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Theta]", "k"], "-", 
         RowBox[{"\[CapitalDelta]t", " ", "\[Omega]"}]}], ")"}]}], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t", " ", 
       SubscriptBox["\[Theta]", 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}]]}]}], 
     RowBox[{
      SubscriptBox["P", 
       RowBox[{
        RowBox[{"k", "-", "1"}], "|", 
        RowBox[{"k", "-", "1"}]}]], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]}]]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "16481cc6-4f09-4de2-817c-fc14bb890c5a"]
}], "Text",
 CellChangeTimes->{{3.980938840092063*^9, 3.980938886313446*^9}, {
  3.9809389988395023`*^9, 3.9809390273409157`*^9}, {3.980939057855447*^9, 
  3.9809391002430563`*^9}, {3.980939246992763*^9, 
  3.9809392477039223`*^9}},ExpressionUUID->"e14974e5-138a-4a50-b337-\
36d6d942fff4"],

Cell[TextData[{
 "The variance of the desired distribution is \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"variance", "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["P", 
        RowBox[{
         RowBox[{"k", "-", "1"}], "|", 
         RowBox[{"k", "-", "1"}]}], 
        RowBox[{"-", "1"}]], "+", 
       FractionBox["1", 
        RowBox[{"2", " ", 
         SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99ac343e-d896-4972-80b6-bea29b20a3c0"],
 "\n\t"
}], "Text",
 CellChangeTimes->{{3.980938892204624*^9, 3.980938984631425*^9}, {
