Cell[TextData[{
 "complete-data log likelihood:\n\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptL]", "c"], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Theta]", "0"], "-", 
          SubscriptBox["\[Mu]", "\[Theta]"]}], ")"}], "2"], 
       RowBox[{"2", 
        SubsuperscriptBox["\[Sigma]", "\[Theta]", "2"]}]]}], "-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Omega]", "-", 
         SubscriptBox["\[Mu]", "\[Omega]"]}], ")"}], "2"], 
      RowBox[{"2", 
       SubsuperscriptBox["\[Sigma]", "\[Omega]", "2"]}]], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Alpha]", "D"], "+", "1"}], ")"}], "ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], "-", 
     FractionBox[
      SubscriptBox["\[Beta]", "D"], 
      SubscriptBox["D", "\[Theta]"]], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Alpha]", "R"], "+", "1"}], ")"}], "ln", " ", "R"}], 
     "-", 
     FractionBox[
      SubscriptBox["\[Beta]", "R"], "R"]}]}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], "N", " ", "ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Theta]", "1"], "-", 
         SubscriptBox["\[Theta]", "0"], "-", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], "2"]}], "-", 
     
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]], "[", 
      RowBox[{
       SubscriptBox["S", "0"], "-", 
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["S", "1"], "(", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}]}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "  ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
      "]"}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       FractionBox["1", "2"], "N", " ", "ln", " ", "R"}]}], "-", 
     FractionBox["S", 
      RowBox[{"2", "R"}]]}]}], TraditionalForm]}],ExpressionUUID->
  "a95d9635-c745-4fae-af85-4da6822f4bb0"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "0"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "2"}], "N"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Theta]", "k"], "-", 
        SubscriptBox["\[Theta]", 
         RowBox[{"k", "-", "1"}]]}], ")"}], "2"]}]}], TraditionalForm]],
  ExpressionUUID->"9b6d299c-ba5c-481a-b88f-58ef04a8ac96"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "2"}], "N"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Theta]", "k"], "-", 
       SubscriptBox["\[Theta]", 
        RowBox[{"k", "-", "1"}]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"ff44c4d7-4616-4df2-91ca-de6e03d225ac"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "N"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["y", "k"], "-", 
        SubscriptBox["\[Theta]", "k"]}], ")"}], "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25f234f2-8216-4a2b-aa78-8f4b67a29c52"]
}], "Text",
