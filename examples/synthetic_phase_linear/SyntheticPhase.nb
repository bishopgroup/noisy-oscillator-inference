Cell[CellGroupData[{

Cell["Frequency", "Subsection",
 CellChangeTimes->{{3.9810209608194313`*^9, 
  3.981020965320126*^9}},ExpressionUUID->"f8c7c1b1-44d0-4507-9f55-\
3bad6912d4ce"],

Cell[TextData[{
 "The variance of ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b78896d1-7dbc-4965-89fd-1f168c02916c"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Var", "(", "\[Omega]", ")"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], 
        SubscriptBox["S", "0"]}], "-", 
       SubsuperscriptBox["S", "1", "2"]}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{"3", "+", "N"}], ")"}], " ", 
       SuperscriptBox["\[CapitalDelta]t", "2"]}]], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SubscriptBox[
         OverscriptBox["D", "^"], "\[Theta]"]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], "\[CapitalDelta]t"}]], "=", 
      FractionBox[
       RowBox[{"2", " ", 
        SubscriptBox[
         OverscriptBox["D", "^"], "\[Theta]"]}], "\[ScriptCapitalT]"]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e86e3fb4-bede-417e-af85-ba432c494b3d"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"sd", "(", "\[Omega]", ")"}], "\[Omega]"], "=", 
    SqrtBox[
     FractionBox[
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"]}], 
      RowBox[{"\[ScriptCapitalT]", " ", 
       SuperscriptBox["\[Omega]", "2"]}]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76d2d190-5c89-42f5-a2c3-25ba578c5a50"],
 "\n\nwhich involves the Peclet number ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Pe", "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Omega]", "2"], "\[ScriptCapitalT]"}], 
     SubscriptBox["D", "\[Theta]"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "637980eb-5992-481b-81ea-f622f8c01f23"],
 " measuring convection vs. diffusion over the whole trajectory."
}], "Text",
 CellChangeTimes->{{3.9810205335928926`*^9, 3.9810206007790947`*^9}, {
  3.981020683038975*^9, 3.981020762441972*^9}, {3.981020792753736*^9, 
  3.981020815788137*^9}, {3.981020852892597*^9, 3.981020950832098*^9}, {
  3.981025371276246*^9, 
  3.981025378313408*^9}},ExpressionUUID->"13644d9c-3c91-4c3f-9381-\
875eb32a1bd0"],

Cell[TextData[{
 "We require that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"sd", "(", "\[Omega]", ")"}], "\[Omega]"], "\[LessLess]", "1"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d5ce85f6-6af8-4dcb-bb9b-e5b39b885275"],
 " which implies that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Pe", "\[GreaterGreater]", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "15617d3d-62e2-4f1c-b21c-41bc6be9600a"],
 "."
}], "Text",
 CellChangeTimes->{{3.981025364453529*^9, 
  3.98102540265936*^9}},ExpressionUUID->"07bd378f-9466-463b-bae1-\
1b59d825fc31"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Diffusivity", "Subsection",
 CellChangeTimes->{{3.9810209608194313`*^9, 
  3.981020989364388*^9}},ExpressionUUID->"a5446c02-7f28-4733-af0f-\
c37e16f4d2d8"],

Cell[TextData[{
 "The standard deviation of the log of the diffusivity is \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"sd", "(", 
     RowBox[{"ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], ")"}], "=", 
    RowBox[{
     SqrtBox[
      FractionBox["2", 
       RowBox[{"3", "+", "N"}]]], "\[Proportional]", 
     FractionBox["1", "N"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "179aa362-5302-4632-a51e-d9b26b99e63d"]
}], "Text",
 CellChangeTimes->{{3.981020995491437*^9, 
  3.981021050844247*^9}},ExpressionUUID->"7c19efb0-358b-46e2-98b4-\
3a7080f9f832"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Improved diffusivity estimate", "Subsection",
 CellChangeTimes->{{3.981141270489923*^9, 
  3.981141286310712*^9}},ExpressionUUID->"a27b2766-f80a-46cb-af4d-\
849c3882e66a"],

Cell[TextData[{
 "Consider that the displacements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c5a5d36-558b-44a3-8c0d-6d341048fb59"],
 " are normally distributed with mean ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bfb21412-5ad8-4f66-bbb8-d4c0ec256524"],
 " and variance ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "+", 
    RowBox[{"2", "R"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a275216-03b2-4089-8ba7-1f4f79781aa5"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "=", 
    RowBox[{"2", 
     SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "aa973d32-d8b0-428c-91c9-9ea360666f35"],
 ".  This approximation assumes that the noise contributions are \
uncorrelated, which is not the case."
}], "Text",
 CellChangeTimes->{{3.981141292653798*^9, 
  3.9811413569352903`*^9}},ExpressionUUID->"650b41dd-3e1b-4fd7-8687-\
9d070e226c5a"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptL]", "c"], "(", 
    RowBox[{"\[Lambda]", ";", "y"}], ")"}], "=", 
   RowBox[{"constant", "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"N", "-", "1"}], ")"}], "ln", " ", 
     RowBox[{"(", 
      RowBox[{"Q", "+", 
       RowBox[{"2", " ", "R"}]}], ")"}]}], "-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"Q", "+", 
         RowBox[{"2", "R"}]}], ")"}]}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "N"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]y", "k"], "-", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], "2"]}]}]}]}],
   TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"4e375b63-1d0a-4b96-94d3-be08c3a48095"]], \
"Text",
 CellChangeTimes->{{3.9811413806841516`*^9, 
  3.9811414034335527`*^9}},ExpressionUUID->"bb5d1d05-e5a8-4263-a977-\
0249c028b5b3"],

Cell[TextData[{
 "Our estimate of ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "32f58dbe-6e55-467c-8218-fe072275bce5"],
 " is \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "Q"], 
     SubscriptBox["\[ScriptL]", "c"]}], "=", 
    RowBox[{"0", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], 
        RowBox[{"Q", "+", 
         RowBox[{"2", " ", "R"}]}]]}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"Q", "+", 
            RowBox[{"2", "R"}]}], ")"}], "2"]}]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", "=", "1"}], "N"], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[CapitalDelta]y", "k"], "-", 
           RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], 
         "2"]}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "024c9f37-6703-41ac-9d0b-44a930493f67"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     RowBox[{"Q", "+", 
      RowBox[{"2", "R"}]}], "\[OverBrace]"], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"(", 
       RowBox[{"N", "-", "1"}], ")"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "N"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]y", "k"], "-", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], "2"]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f320e34e-a602-4d1e-8967-545542af2fe2"]
}], "Text",
 CellChangeTimes->{{3.981141418409904*^9, 3.981141425082759*^9}, {
  3.981141462842403*^9, 3.981141538542501*^9}, {3.981141591818626*^9, 
  3.981141591818722*^9}, {3.9811416322105427`*^9, 
  3.981141634837462*^9}},ExpressionUUID->"4225bfa8-314a-4d5a-974d-\
0e1e42a3ad76"],

Cell[TextData[{
 "Lets call ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"Q", "+", 
     RowBox[{"2", "D"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c5ad3cfc-81e6-4337-a5de-b8e84d68e8cd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{"ln", " ", "x"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1de2087e-3dc1-4ec1-b38c-d818b459d8b2"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "y"], "f"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], "f"}], 
      RowBox[{
       SubscriptBox["\[PartialD]", "y"], "x"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], "f"}], " ", 
       SuperscriptBox["e", "y"]}], "=", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], "f"}]}], "=", "0"}]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aef2c78f-e32d-4ed5-8a1d-3269337b0ddc"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"y", ",", "y"}]], "f"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "y"], 
      RowBox[{"(", 
       RowBox[{"x", " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], "f"}]}], ")"}]}], "=", 
     RowBox[{
      RowBox[{"x", 
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], 
        RowBox[{"(", 
         RowBox[{"x", " ", 
          RowBox[{
           SubscriptBox["\[PartialD]", "x"], "f"}]}], ")"}]}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["x", "2"], 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], "f"}]}], "+", 
        RowBox[{"x", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "x"], "f"}]}]}], "=", 
       RowBox[{
        SuperscriptBox["x", "2"], 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"x", ",", "x"}]], "f"}]}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d0d56906-381c-491d-a75b-75004adcb020"]
}], "Text",
 CellChangeTimes->{{3.98114179069803*^9, 
  3.981141949177733*^9}},ExpressionUUID->"ca04c7a9-dafb-4ee0-b8a1-\
4fbcc3adb104"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"Q", ",", "Q"}]], 
     SubscriptBox["\[ScriptL]", "c"]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Q", "+", 
          RowBox[{"2", " ", "R"}]}], ")"}], "2"]]}], "-", 
     RowBox[{
      FractionBox["2", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"Q", "+", 
           RowBox[{"2", "R"}]}], ")"}], "3"]}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]y", "k"], "-", 
          RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], 
        "2"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "700ff7a2-3781-469b-ad8e-b67163717c97"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"Q", ",", "Q"}]], 
     SubscriptBox["\[ScriptL]", "c"]}], "=", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{"N", "-", "1"}], ")"}], 
      RowBox[{"2", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Q", "+", 
          RowBox[{"2", "R"}]}], ")"}], "2"]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dbeb75de-6f9b-43b8-b16c-9597d2b239d3"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"Q", ",", "Q"}]], 
     SubscriptBox["\[ScriptL]", "c"]}], "=", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{"N", "-", "1"}], ")"}], 
      RowBox[{"2", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Q", "+", 
          RowBox[{"2", "R"}]}], ")"}], "2"]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff21250f-aadb-40ea-9632-f678129b843f"],
 "\n\t\t"
}], "Text",
 CellChangeTimes->{{3.981141542441124*^9, 3.981141578915627*^9}, {
  3.981141642828183*^9, 3.981141694749867*^9}, {3.9811419815919657`*^9, 
  3.981142005589609*^9}, {3.981142070524755*^9, 
  3.981142093001796*^9}},ExpressionUUID->"19fe66b6-1124-4783-801b-\
580a65113c17"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Analysis: Diffusion Free ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4542b3c-5ac3-4248-abab-74ddbd420b71"]
}], "Section",
 CellChangeTimes->{{3.981018980133402*^9, 3.981018993709015*^9}, {
  3.981021998571425*^9, 
  3.98102200029559*^9}},ExpressionUUID->"e7db2bab-e4c9-4bcc-bb7d-\
97cc1a90c9bc"],

Cell[TextData[{
 "Consider that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c79dfe1-c8e8-4b5e-9059-f7e2ca549b8b"],
 " such that there is no diffusion.  This becomes a linear regression \
problem:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "k"], "=", 
    RowBox[{
     RowBox[{"\[Omega]", " ", 
      SubscriptBox["t", "k"]}], "+", 
     SubscriptBox["\[Theta]", "0"], "+", 
     SubscriptBox["\[Eta]", "k"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad6c2361-08c0-4180-b569-2386be561ae7"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "k"], "=", 
    RowBox[{"k", " ", "\[CapitalDelta]t"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7955b7ac-4e7c-4249-9363-fad1aca8e854"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "1"}], ",", "...", ",", "N"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "827ddc59-f15e-4456-aa00-e2bede188778"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", "k"], "\[Tilde]", 
    RowBox[{"\[ScriptCapitalN]", "(", 
     RowBox[{"0", ",", "R"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eeb5ae60-6549-489b-8bef-8cfa711360ed"]
}], "Text",
 CellChangeTimes->{{3.981018996242434*^9, 3.981019078031702*^9}, {
  3.981022002958229*^9, 3.981022065275076*^9}, {3.981022112751863*^9, 
  3.981022143837262*^9}, {3.9810221819050922`*^9, 
  3.981022189065304*^9}},ExpressionUUID->"6098d857-506f-4b97-8b6f-\
68c7f377375a"],

Cell[TextData[{
 "We seek to estimate ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "627b330b-2479-4a20-8ead-dda96b2b75fd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4189016a-ee3d-4943-8ba5-ac10568a9b12"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ln", " ", "R"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3cdbde12-d132-493e-8ae2-868975e43092"],
 " using the laplace approximation.  Using an ignorance prior, the log \
posterior is \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"L", "(", "\[Lambda]", ")"}], "=", 
    RowBox[{"constant", "-", 
     RowBox[{"ln", " ", "R"}], "-", 
     RowBox[{
      FractionBox["1", "2"], "N", " ", "ln", " ", "R"}], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", "R"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["y", "k"], "-", 
          RowBox[{"\[Omega]", " ", "k", " ", "\[CapitalDelta]t"}], "-", 
          SubscriptBox["\[Theta]", "0"]}], ")"}], "2"]}]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ce08085-bfb5-4b64-a6b9-d6b0a198b848"]
}], "Text",
 CellChangeTimes->{{3.981022276183069*^9, 
  3.981022492466613*^9}},ExpressionUUID->"852aa605-35dc-4787-88ec-\
903a444ef3ed"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Omega]"], "L"}], "=", 
    RowBox[{"0", "=", 
     RowBox[{
      FractionBox["1", "R"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["y", "k"], "-", 
          RowBox[{"\[Omega]", " ", 
           SubscriptBox["t", "k"]}], "-", 
          SubscriptBox["\[Theta]", "0"]}], ")"}], 
        SubscriptBox["t", "k"]}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0ab568b0-efc3-45e3-ad3f-b6dde361b537"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      SubscriptBox["\[Theta]", "0"]], "L"}], "=", 
    RowBox[{"0", "=", 
     RowBox[{
      FractionBox["1", "R"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["y", "k"], "-", 
         RowBox[{"\[Omega]", " ", 
          SubscriptBox["t", "k"]}], "-", 
         SubscriptBox["\[Theta]", "0"]}], ")"}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9cb5b8fc-4879-491a-b080-ed36e41921d8"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "N"], 
      RowBox[{
       SubscriptBox["t", "k"], 
       SubscriptBox["y", "k"]}]}], "-", 
     RowBox[{"\[Omega]", " ", 
      RowBox[{"(", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", "=", "1"}], "N"], 
        SubsuperscriptBox["t", "k", "2"]}], ")"}]}], "-", 
     RowBox[{
      SubscriptBox["\[Theta]", "0"], "(", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       SubscriptBox["t", "k"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa68cca8-5b50-4cda-b57c-811ed6a1f853"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "N"], 
      SubscriptBox["y", "k"]}], "-", 
     RowBox[{"\[Omega]", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], " ", 
       SubscriptBox["t", "k"]}]}], "-", 
     RowBox[{"N", " ", 
      SubscriptBox["\[Theta]", "0"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "502f371a-23bb-49d5-8a0e-2fb5e1ee332d"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox["\[CapitalDelta]t", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"N", "+", "1"}], ")"}], "\[Omega]"}], "+", 
      SubscriptBox["\[Theta]", "0"]}], "=", 
     RowBox[{
      FractionBox["1", "N"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       RowBox[{"k", " ", 
        SubscriptBox["y", "k"]}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b0ef50a3-edb9-4ac5-87d7-b11ee772a946"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]t", " ", "\[Omega]"}], "  ", "+", " ", 
     SubscriptBox["\[Theta]", "0"]}], "=", 
    RowBox[{
     FractionBox["1", "N"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "N"], 
      SubscriptBox["y", "k"]}]}]}], TraditionalForm]],ExpressionUUID->
  "358111b1-d87d-4e17-ab36-d81442497c7b"]
}], "Text",
