       RowBox[{"2", " ", 
        SubscriptBox["D", "\[Theta]"], " "}]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Theta]", "^"], "1"], "-", 
        SubscriptBox["\[Theta]", "0"], "-", 
        RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}]}], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], 
        SubscriptBox[
         OverscriptBox["S", "^"], "1"], " ", "\[CapitalDelta]t"}], " ", "+", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], "\[Omega]", "  ", 
        SuperscriptBox["\[CapitalDelta]t", "2"]}]}], "]"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c917db02-8964-4584-a0e8-3df3a68d7933"],
 "\n\twith ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["S", "^"], "1"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "2"}], "N"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["\[Theta]", "^"], "k"], "-", 
       SubscriptBox[
        OverscriptBox["\[Theta]", "^"], 
        RowBox[{"k", "-", "1"}]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"74a76f96-af44-414e-b453-a9dddf7a19b9"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       SubscriptBox["D", "\[Theta]"]], 
      SubscriptBox["\[ScriptL]", "c"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SubscriptBox["\[Alpha]", "D"], "+", "1"}], 
       SubscriptBox["D", "\[Theta]"]]}], "+", 
     FractionBox[
      SubscriptBox["\[Beta]", "D"], 
      SubsuperscriptBox["D", "\[Theta]", "2"]], "-", 
     FractionBox["N", 
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"]}]], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubsuperscriptBox["D", "\[Theta]", "2"], " ", "\[CapitalDelta]t"}]], 
      "[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["\[Theta]", "^"], "1"], "-", 
          SubscriptBox["\[Theta]", "0"], "-", 
          RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], "2"], "+", 
       SubscriptBox["\[CapitalSigma]", 
        RowBox[{"1", ",", "1"}]]}], "]"}], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", "  ", 
        SubsuperscriptBox["D", "\[Theta]", "2"], " ", "\[CapitalDelta]t"}]], 
      "[", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["S", "^"], "0"], "-", 
       RowBox[{"2", 
        RowBox[{
         SubscriptBox[
          OverscriptBox["S", "^"], "1"], "(", 
         RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}]}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "  ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
      "]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0dae523-d10b-4e7e-b0cb-24028dac99af"],
 "\n\twith ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["S", "^"], "0"], "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "2"}], "N"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Theta]", "k"], "-", 
         SubscriptBox["\[Theta]", 
          RowBox[{"k", "-", "1"}]]}], ")"}], "2"]}], "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "2"}], "N"], 
      RowBox[{"[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SubscriptBox[
            OverscriptBox["\[Theta]", "^"], "k"], "-", 
           SubscriptBox[
            OverscriptBox["\[Theta]", "^"], 
            RowBox[{"k", "-", "1"}]]}], ")"}], "2"], "+", 
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"k", ",", "k"}]], "+", 
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{
          RowBox[{"k", "-"}], ",", 
          RowBox[{"k", "-", "1"}]}]], "-", 
        RowBox[{"2", 
         SubscriptBox["\[CapitalSigma]", 
          RowBox[{"k", ",", 
           RowBox[{"k", "-", "1"}]}]]}]}], "]"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"d46f9f4a-4e1c-4775-98b6-87a497643ac3"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      SubscriptBox["\[PartialD]", "R"], 
      SubscriptBox["\[ScriptL]", "c"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SubscriptBox["\[Alpha]", "R"], "+", "1"}], "R"]}], "+", 
     FractionBox[
      SubscriptBox["\[Beta]", "R"], 
      SuperscriptBox["R", "2"]], "-", 
     FractionBox["N", 
      RowBox[{"2", "R"}]], "+", 
     FractionBox[
      OverscriptBox["S", "^"], 
      RowBox[{"2", " ", 
       SuperscriptBox["R", "2"]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d21b29ff-ceae-49df-98b1-f96c60be8a82"],
 "\n\twith ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["S", "^"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "N"], 
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["y", "k"], "-", 
          SubscriptBox[
           OverscriptBox["\[Theta]", "^"], "k"]}], ")"}], "2"], "+", 
       SubscriptBox["\[CapitalSigma]", 
        RowBox[{"k", ",", "k"}]]}], "]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dcad5031-4838-4a0c-827f-a24c87b1a7d2"]
}], "Text",
 CellChangeTimes->{{3.980853436386991*^9, 
  3.9808537549278584`*^9}},ExpressionUUID->"a620a6a5-a865-4038-8921-\
e5d57fc89995"],

Cell[TextData[{
 "Covariance matrix:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         SubscriptBox["\[Theta]", "0"]], 
        SubscriptBox["\[ScriptL]", "c"]}], ")"}], "2"], "]"}], "=", 
    RowBox[{
     RowBox[{"\[DoubleStruckCapitalE]", "[", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Theta]", "0"], "-", 
             SubscriptBox["\[Mu]", "\[Theta]"]}], ")"}], 
           SubsuperscriptBox["\[Sigma]", "\[Theta]", "2"]]}], "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", " ", 
            SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Theta]", "1"], "-", 
            SubscriptBox["\[Theta]", "0"], "-", 
            RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}]}]}], ")"}],
        "2"], "]"}], "=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Theta]", "0"], "-", 
             SubscriptBox["\[Mu]", "\[Theta]"]}], ")"}], 
           SubsuperscriptBox["\[Sigma]", "\[Theta]", "2"]]}], "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", " ", 
            SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox[
             OverscriptBox["\[Theta]", "^"], "1"], "-", 
            SubscriptBox["\[Theta]", "0"], "-", 
            RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}]}]}], ")"}],
        "2"], "+", 
      FractionBox[
       SubscriptBox["\[CapitalSigma]", 
        RowBox[{"1", ",", "1"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", " ", 
          SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}], ")"}], 
        "2"]]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "096dee99-575f-4cb6-bcee-2940be8b898a"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Cov", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["\[Theta]", "0"]], 
       SubscriptBox["\[ScriptL]", "c"]}], ",", 
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["\[Theta]", "0"]], 
       SubscriptBox["\[ScriptL]", "c"]}]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[DoubleStruckCapitalE]", "[", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           SubscriptBox["\[Theta]", "0"]], 
          SubscriptBox["\[ScriptL]", "c"]}], ")"}], "2"], "]"}], "-", 
      SuperscriptBox[
       RowBox[{"\[DoubleStruckCapitalE]", "[", 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          SubscriptBox["\[Theta]", "0"]], 
         SubscriptBox["\[ScriptL]", "c"]}], "]"}], "2"]}], "=", 
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       RowBox[{"1", ",", "1"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"2", " ", 
         SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}], ")"}], 
       "2"]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3978f41d-9e6c-4450-ada3-54b8755b25da"]
}], "Text",
 CellChangeTimes->{
  3.9808673237365723`*^9},ExpressionUUID->"bb4f60cf-8373-4ce8-a4ea-\
767488b9b913"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["\[Theta]", "0"]], 
       SubscriptBox["\[ScriptL]", "c"]}], 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Omega]"], 
       SubscriptBox["\[ScriptL]", "c"]}]}], "]"}], "=", 
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Theta]", "0"], "-", 
            SubscriptBox["\[Mu]", "\[Theta]"]}], ")"}], 
          SubsuperscriptBox["\[Sigma]", "\[Theta]", "2"]]}], "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", " ", 
           SubscriptBox["D", "\[Theta]"], " ", "\[CapitalDelta]t"}]], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Theta]", "1"], "-", 
           SubscriptBox["\[Theta]", "0"], "-", 
           RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}]}]}], ")"}], 
      
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"\[Omega]", "-", 
            SubscriptBox["\[Mu]", "\[Omega]"]}], ")"}], 
          SubsuperscriptBox["\[Sigma]", "\[Omega]", "2"]]}], "+", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", " ", 
           SubscriptBox["D", "\[Theta]"], " "}]], 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Theta]", "1"], "-", 
           SubscriptBox["\[Theta]", "0"], "-", 
           RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}]}], "-", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", " ", 
           SubscriptBox["D", "\[Theta]"], " "}]], "[", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["S", "1"]}], "  ", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"N", "-", "1"}], ")"}], "\[Omega]", "  ", 
           "\[CapitalDelta]t"}]}], "]"}]}], ")"}]}], "]"}]}], 
   TraditionalForm]],ExpressionUUID->"bf2a2699-fc44-4f5c-aaf8-1c01ea68e4cd"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleStruckCapitalE]", "[", 
     RowBox[{
      SubscriptBox["\[Theta]", "1"], 
      SubscriptBox["S", "1"]}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[DoubleStruckCapitalE]", "[", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "2"}], "N"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Theta]", "1"], 
          SubscriptBox["\[Theta]", "k"]}], "-", 
         RowBox[{
          SubscriptBox["\[Theta]", "1"], 
          SubscriptBox["\[Theta]", 
           RowBox[{"k", "-", "1"}]]}]}], ")"}]}], "]"}], "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "2"}], "N"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"1", ",", "k"}]], "-", 
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"1", ",", 
          RowBox[{"k", "-", "1"}]}]]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"e022bb80-329a-447d-879f-5ccb48add07e"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Cov", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        SubscriptBox["\[Theta]", "0"]], 
       SubscriptBox["\[ScriptL]", "c"]}], ",", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Omega]"], 
       SubscriptBox["\[ScriptL]", "c"]}]}], ")"}], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       RowBox[{"1", ",", "1"}]], 
      RowBox[{"4", 
       SubsuperscriptBox["D", "\[Theta]", "2"], " ", "\[CapitalDelta]t"}]], 
     "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", 
        SubsuperscriptBox["D", "\[Theta]", "2"], "  ", "\[CapitalDelta]t"}]], 
      
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "2"}], "N"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", 
          RowBox[{"1", ",", "k"}]], "-", 
         SubscriptBox["\[CapitalSigma]", 
          RowBox[{"1", ",", 
           RowBox[{"k", "-", "1"}]}]]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"101d039c-77ce-4fef-a308-e4a0aab9778f"]
}], "Text",
 CellChangeTimes->{{3.98085379237425*^9, 3.980853815128254*^9}, {
