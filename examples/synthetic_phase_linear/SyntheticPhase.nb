  3.981019845236108*^9}},ExpressionUUID->"57891735-c346-47c6-a160-\
23d9d7626713"],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Omega]", "-", "\[Mu]\[Omega]"}], ")"}], "2"], 
      RowBox[{"2", 
       SuperscriptBox["\[Sigma]\[Omega]", "2"]}]]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]D", "+", "1"}], ")"}], 
     RowBox[{"Log", "[", "D\[Theta]", "]"}]}], "-", 
    FractionBox["\[Beta]D", "D\[Theta]"], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"n", "-", "1"}], ")"}], 
     RowBox[{"Log", "[", "D\[Theta]", "]"}]}], "-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", " ", "D\[Theta]", " ", "\[CapitalDelta]t"}]], 
     RowBox[{"(", 
      RowBox[{"S0", "-", 
       RowBox[{"2", " ", "\[Omega]", " ", "\[CapitalDelta]t", " ", "S1"}], 
       "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
      ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9810196844580812`*^9, 3.981019739876384*^9}, {
   3.981019852439314*^9, 3.981019871322695*^9}, 3.9810201819970427`*^9},
 CellLabel->"In[69]:=",ExpressionUUID->"5f0be52a-fe9c-4d6f-b999-dc5c2496ec5b"],

