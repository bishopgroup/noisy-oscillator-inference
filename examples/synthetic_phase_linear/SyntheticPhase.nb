Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"\[Omega]", ",", "\[Omega]"}]], "L"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "R"]}], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       SubsuperscriptBox["t", "k", "2"]}]}], "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["\[CapitalDelta]t", "2"], 
        RowBox[{"6", " ", "R"}]]}], "N", " ", 
      RowBox[{"(", 
       RowBox[{"N", "+", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "N"}], "+", "1"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a16e83b2-049e-4ad2-9466-e5a793ebd857"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"\[Omega]", ",", 
       SubscriptBox["\[Theta]", "0"]}]], "L"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "R"]}], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       SubscriptBox["t", "k"]}]}], "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{" ", "\[CapitalDelta]t"}], 
        RowBox[{"2", "R"}]]}], " ", "N", " ", 
      RowBox[{"(", 
       RowBox[{"N", "+", "1"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c7bf1911-67b6-4114-9dc8-bce96c111386"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"\[Omega]", ",", "lnR"}]], "L"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"exp", "(", 
        RowBox[{"-", "lnR"}], ")"}]}], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["y", "k"], "-", 
          RowBox[{"\[Omega]", " ", 
           SubscriptBox["t", "k"]}], "-", 
          SubscriptBox["\[Theta]", "0"]}], ")"}], 
        SubscriptBox["t", "k"]}]}]}], "=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "be584227-2a9d-4ef7-99c5-70f3148411b3"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{
       SubscriptBox["\[Theta]", "0"], ",", 
       SubscriptBox["\[Theta]", "0"]}]], "L"}], "=", 
    RowBox[{"-", 
     FractionBox["N", "R"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05417a4d-cd17-429f-bc80-3e2e6985280b"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{
       SubscriptBox["\[Theta]", "0"], ",", "R"}]], "L"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"exp", "(", 
        RowBox[{"-", "lnR"}], ")"}]}], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["y", "k"], "-", 
