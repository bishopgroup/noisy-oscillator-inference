Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"var", "(", "\[Omega]", ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"12", " ", "R"}], 
     RowBox[{
      RowBox[{"N", "(", 
       RowBox[{
        SuperscriptBox["N", "2"], "-", "1"}], ")"}], " ", 
      SuperscriptBox["\[CapitalDelta]t", "2"]}]], "\[Tilde]", 
    FractionBox[
     RowBox[{"12", " ", "R", " ", "\[CapitalDelta]t"}], 
     SuperscriptBox["\[ScriptCapitalT]", "3"]]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"3eb9168e-42cb-4eef-874c-9a7618ea3410"]], \
