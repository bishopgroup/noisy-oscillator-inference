Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{"Grad", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "L"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Sigma]\[Omega]", "->", "Infinity"}], ",", 
             RowBox[{"\[Alpha]D", "->", "0"}], ",", 
             RowBox[{"\[Beta]D", "->", "0"}]}], "}"}]}], "/.", 
          RowBox[{"{", 
           RowBox[{"D\[Theta]", "->", 
            RowBox[{"Exp", "[", "lnD\[Theta]", "]"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Omega]", ",", "lnD\[Theta]"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", "lnD\[Theta]"}], "}"}]}], "]"}], "/.", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Omega]", "\[Rule]", 
        FractionBox["S1", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
          "\[CapitalDelta]t"}]]}], ",", 
       RowBox[{"lnD\[Theta]", "\[Rule]", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"S0", "-", 
           RowBox[{"n", " ", "S0"}], "+", 
           SuperscriptBox["S1", "2"]}], 
          RowBox[{
           RowBox[{"2", " ", "\[CapitalDelta]t"}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["n", "2"], " ", "\[CapitalDelta]t"}]}]], "]"}]}]}],
       "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"H", "//", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.981020237112647*^9, 3.9810202777396*^9}, 
   3.9810203714486017`*^9, {3.9811420558936167`*^9, 3.981142056329875*^9}, 
   3.981142537405435*^9, 3.981142603183515*^9},
 CellLabel->
  "In[133]:=",ExpressionUUID->"6d8051a0-7f8a-42f4-af67-458ed74c234a"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
