Cell[TextData[{
 "Consider that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd596e9b-9cb0-4bfe-ab99-b0059efefd3a"],
 " such that there is no noise.  Then I can infer the model parameters ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0bced10-c87b-48af-8b5d-67e7ce48f936"],
 " and ",
