Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Grad", "[", 
     RowBox[{
      RowBox[{"lc", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"D\[Theta]", "->", 
          RowBox[{"Exp", "[", "lnD\[Theta]", "]"}]}], ",", 
         RowBox[{"R", "->", 
          RowBox[{"Exp", "[", "lnR", "]"}]}]}], "}"}]}], ",", 
