  3.980677412505748*^9},ExpressionUUID->"2079da2b-4b40-4dad-b4f4-\
ef5c3e0e274c"],

Cell[TextData[{
 "Our goal is the maximize the posterior ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{"\[Theta]", "|", "X"}], ")"}], "\[Proportional]", 
    RowBox[{
     RowBox[{"p", "(", 
      RowBox[{"X", "|", "\[Theta]"}], ")"}], 
     RowBox[{"p", "(", "\[Theta]", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5844045-83c2-4fca-a17f-19dceab73752"],
 " with respect to ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9788fa0d-9055-405c-8cbe-d3cba4f2fe89"],
 "."
}], "Text",
 CellChangeTimes->{{3.9806774505212593`*^9, 
  3.980677490625142*^9}},ExpressionUUID->"73a5fe98-1bc0-4021-8134-\
0fd6b45be684"],

Cell[TextData[{
 "We have latent parameters ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce1446a2-3414-4819-897c-b2a4cccd55b1"],
 ", such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{"X", "|", "\[Theta]"}], ")"}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", "Z"], 
     RowBox[{"p", "(", 
      RowBox[{"X", ",", 
       RowBox[{"Z", "|", "\[Theta]"}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9b05880-0e0c-4637-961e-706d43200d89"],
 "."
}], "Text",
 CellChangeTimes->{{3.980677651496544*^9, 3.980677680346016*^9}, 
   3.9806777458315887`*^9},ExpressionUUID->"73b9885e-5794-4e7f-a892-\
2ef2986814d6"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Q", "(", 
    RowBox[{"\[Theta]", ",", 
     SubscriptBox["\[Theta]", "old"]}], ")"}], "=", 
   RowBox[{
    RowBox[{
