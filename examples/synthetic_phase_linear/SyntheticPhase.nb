Cell["\<\
There three cross-overs:  (1) Drift-Diffusion, (2) Diffusion-Noise, (3) \
Noise-Drift.\
\>", "Text",
 CellChangeTimes->{{3.981107516551641*^9, 3.9811075657825623`*^9}, {
  3.981107683526535*^9, 
  3.981107690745679*^9}},ExpressionUUID->"b4636b4b-7f59-4bad-885e-\
245c6099e45b"],

Cell[TextData[{
 "(1) Drift-Diffusion:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}], "2"], "\[TildeTilde]", 
    RowBox[{"2", 
     SubscriptBox["D", "\[Theta]"], "t"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b6cbe854-708d-4076-ad6e-0d2d0c128526"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "1"], "=", 
    RowBox[{"2", " ", 
     RowBox[{
      SubscriptBox["D", "\[Theta]"], "/", 
      SuperscriptBox["\[Omega]", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4e4ba11-0d9d-4aa2-8f8e-2deb1a4e1efa"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["msd", "1"], "=", 
    RowBox[{"4", 
     RowBox[{
      SubsuperscriptBox["D", "\[Theta]", "2"], "/", 
      SuperscriptBox["\[Omega]", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5784eff5-4252-4847-a61a-fee00acf68b6"]
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.981107572163597*^9, 3.9811076638395653`*^9}, {
  3.981107707750949*^9, 
  3.981107711249566*^9}},ExpressionUUID->"12b52dc3-c497-464a-864a-\
88d7d7337a92"],

Cell[TextData[{
 "(2) Diffusion-Noise:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", 
     SubscriptBox["D", "\[Theta]"], "t"}], "\[TildeTilde]", 
    RowBox[{"2", "R"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c314adc-2c32-4916-902c-87395541d037"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "2"], "=", 
    RowBox[{"R", "/", 
     SubscriptBox["D", "\[Theta]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4550dc1f-bc88-4d7c-873d-c9acec8b9fdc"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["msd", "2"], "=", 
    RowBox[{"2", "R"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1644fa74-62c6-48e5-af4b-721887267573"]
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.981107572163597*^9, 
  3.9811077392139597`*^9}},ExpressionUUID->"ddd26fdd-95c6-4428-bf3d-\
d29eb4af88a0"],

Cell[TextData[{
 "(3) Noise-Drift:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "R"}], "\[TildeTilde]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}], "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "96b69a43-13e2-45c4-9058-c3f5b6680de5"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "3"], "=", 
    SqrtBox[
     RowBox[{"2", " ", 
      RowBox[{"R", "/", 
       SuperscriptBox["\[Omega]", "2"]}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69ce0c8d-fbac-4f2c-9014-8774824a1404"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["msd", "3"], "=", 
    RowBox[{"2", "R"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "63056b2a-baa7-49ce-84bf-1fdf0eff557b"]
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.981107572163597*^9, 3.981107753409689*^9}, {
  3.981107801541902*^9, 
  3.981107838659981*^9}},ExpressionUUID->"87701ff3-836b-458f-91ac-\
e4e05b821310"],

Cell[TextData[{
 "We can scale phase and time such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ceb755f-b9e0-48d1-8d50-b9b9b42282a4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b9567896-75c0-422e-a850-3d3334b6f0f3"],
 ".  Then the msd is parameterized by ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "036a803a-cb3a-43ed-9cbf-0bb01d57f10e"],
 " alone.\n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"msd", "=", 
    RowBox[{
     RowBox[{"2", "R"}], " ", "+", 
     RowBox[{"2", "t"}], "+", 
     SuperscriptBox["t", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a1cdb0b-5a88-475c-a0c5-15da9a2f8517"],
 "\t"
}], "Text",
 CellChangeTimes->{{3.9811078472539873`*^9, 
  3.981107916376354*^9}},ExpressionUUID->"7ba57825-1969-4121-92e2-\
095eabbfeef6"],

Cell[TextData[{
 "There are two noise regimes:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "I", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc92bee8-d21f-4562-956a-e9c1a8ce0f90"],
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "\[LessLess]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "27e3bf6d-2a5b-4570-b973-83650bc05b6d"],
 "\tDiffusion dominated regime ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "2"], "\[LessLess]", "t", "\[LessLess]", 
    SubscriptBox["t", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df2ceee1-5f6c-4495-98c8-8a0bb56d425a"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "II", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e6cd5d17-072c-4dbb-8554-8b2127db44cc"],
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[LessLess]", "R"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3925c6a-eb3a-420f-8c62-8bf60a1a8bae"],
 "\tNo-diffusion dominated regime\t"
}], "Text",
 CellChangeTimes->{{3.9811079179718933`*^9, 3.981108101279052*^9}, {
  3.981108142943818*^9, 
  3.981108158089878*^9}},ExpressionUUID->"5c08861d-264b-47e0-97d0-\
ee0292b0a294"],

Cell[TextData[{
 "We get to select ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "min"], "=", "\[CapitalDelta]t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a85bbd1-e6c8-4f3f-a32d-9ddd44f1e9c8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "max"], "=", 
    RowBox[{"N", " ", "\[CapitalDelta]t"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "728007d0-4273-4a38-b489-030f14bf4db5"],
 ".  How do these time scales compare to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "1"], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3d0221b0-043e-4d19-8c47-c34a02b62031"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "2"], "=", "R"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5746ee1a-9675-46a4-a83c-3747d88ee508"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "3"], "=", 
    SqrtBox[
     RowBox[{"2", " ", "R"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "edf39698-df79-46f5-a3c0-618b2f8923ac"],
 "."
}], "Text",
 CellChangeTimes->{{3.981108193401355*^9, 3.981108195540498*^9}, {
  3.9811082416978416`*^9, 3.9811083770519257`*^9}, {3.981108479770152*^9, 
  3.981108488487101*^9}},ExpressionUUID->"559b62bd-b5bb-456a-abdb-\
e7ab1656badf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Frequency", "Subsection",
 CellChangeTimes->{{3.981107406167383*^9, 3.9811074199716988`*^9}, {
  3.981108394375671*^9, 
  3.981108396356228*^9}},ExpressionUUID->"fd347421-2df7-4cf7-8393-\
0d9b1e468aeb"],

Cell[TextData[{
 "When noise is small (",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "\[LessLess]", 
    RowBox[{
     FractionBox["N", "6"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["D", "\[Theta]"], "N", " ", "\[CapitalDelta]t"}], 
      ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4e4ecba-5079-4377-97f7-e369ae59311a"],
 "), the variance in our frequency estimate is \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"var", "(", "\[Omega]", ")"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}], "\[CapitalDelta]t"}]], 
     "\[TildeTilde]", 
     FractionBox[
      RowBox[{"2", " ", 
       SubscriptBox["D", "\[Theta]"]}], 
      RowBox[{"N", " ", "\[CapitalDelta]t"}]]}]}], TraditionalForm]],
  ExpressionUUID->"d2c2d9a8-9900-4de1-9e61-b992d0d32ec8"],
 "\n\nWhen diffusion is small (TBD), the variance in our frequency estimate \
is \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"var", "(", "\[Omega]", ")"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"12", " ", "R"}], 
      RowBox[{
       RowBox[{"N", "(", 
        RowBox[{
         SuperscriptBox["N", "2"], "-", "1"}], ")"}], " ", 
       SuperscriptBox["\[CapitalDelta]t", "2"]}]], "\[TildeTilde]", 
     FractionBox[
      RowBox[{"12", " ", "R", " "}], 
      RowBox[{
       SuperscriptBox["N", "3"], 
       SuperscriptBox["\[CapitalDelta]t", "2"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"59de4d19-9209-4de0-9808-47e92fdc340d"]
}], "Text",
 CellChangeTimes->{{3.981108422658321*^9, 3.981108538635189*^9}, {
  3.981108580274675*^9, 3.981108635467372*^9}, {3.981108875661421*^9, 
  3.981108881399026*^9}},ExpressionUUID->"8524566f-5e59-4f8a-9d90-\
fde22b61927a"],

Cell[TextData[{
 "The cross over occurs for \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"2", " ", 
      SubscriptBox["D", "\[Theta]"]}], 
     RowBox[{"N", " ", "\[CapitalDelta]t"}]], "\[TildeTilde]", 
    FractionBox[
     RowBox[{"12", " ", "R", " "}], 
     RowBox[{
      SuperscriptBox["N", "3"], 
      SuperscriptBox["\[CapitalDelta]t", "2"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c4d21d59-26b1-4e02-9f5c-690a019e93f6"],
 "\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["N", "6"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["D", "\[Theta]"], "N", " ", "\[CapitalDelta]t"}], ")"}]}],
     "\[TildeTilde]", " ", "R"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bf93d658-ad10-4eb2-a485-32624ec76f3e"],
 "\t"
}], "Text",
 CellChangeTimes->{{3.981108653241713*^9, 3.981108700582921*^9}, {
  3.981108818663666*^9, 3.981108870176654*^9}, {3.981113294380909*^9, 
  3.981113294784321*^9}},ExpressionUUID->"69581410-3589-4ee7-8a06-\
23e50adf01bb"],

Cell[TextData[{
 "Consider that we scale ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5dcd63a1-fc8c-46f2-bfff-25adf20135c6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bf6ba4c3-5b08-48e5-ac77-b4bd24b88b16"],
 " and set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]t", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ed38ce4-e3ac-45f6-b9e3-3bde962b75d5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e8d8203-166f-422f-9556-eac2dc97b86d"],
 ".  For large ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c3e74572-fa4b-4e93-a7ef-27227dfb9d35"],
 ", the diffusion limit wins such that \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"var", "(", "\[Omega]", ")"}], "\[TildeTilde]", 
    FractionBox["2", 
     RowBox[{"N", " "}]]}], TraditionalForm]],ExpressionUUID->
  "68960eec-559d-4ef4-9b88-3c6f6702b225"]
}], "Text",
 CellChangeTimes->{{3.9811132963026667`*^9, 
  3.9811134099217567`*^9}},ExpressionUUID->"0bc21103-c925-4831-b994-\
476da2c199cd"],

Cell[TextData[{
 "I think we want to keep ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1394b1e4-5e90-4d22-9ff6-c97a9dffe2ca"],
 " constant and vary ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c703cf24-de1e-4dfe-9f41-cd0e540f6891"],
 ".  Additionally, we can scale \[OpenCurlyDoubleQuote]length\
\[CloseCurlyDoubleQuote] by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "/", "\[Omega]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a030f3f4-e147-4e1e-9345-ce5de2ec5b08"],
 " and time by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "/", 
    SuperscriptBox["\[Omega]", "2"]}], TraditionalForm]],ExpressionUUID->
  "7619523a-0aa8-4e2c-be32-ae436bbb11f1"],
 ".  In these units, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "\[RightArrow]", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0bc759c0-9f91-43a9-bdb4-c0a4d905adce"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "\[RightArrow]", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ede04285-80e1-4fc0-8586-19441644e48f"],
 ".  The time ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "/", 
    SuperscriptBox["\[Omega]", "2"]}], TraditionalForm]],ExpressionUUID->
  "402f6bd8-9fcf-4163-84cd-5671b9a8de7c"],
 " is the cross-over between diffusive-dominated motion (at small times) and \
drift-dominated motion (at large times).  The phase scale ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "/", "\[Omega]"}], TraditionalForm]],
  ExpressionUUID->"dc52e6bb-6ebf-4296-8e56-543fbe92835d"],
 " is how far the system drifts during that time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "(", 
    RowBox[{
     SubscriptBox["D", "\[Theta]"], "/", 
     SuperscriptBox["\[Omega]", "2"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2634edf-2553-4b45-a307-dbde1ab766d6"],
 " or, equivalently, how far the phase diffuses in that time ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     SubscriptBox["D", "\[Theta]"], "(", 
     RowBox[{
      SubscriptBox["D", "\[Theta]"], "/", 
      SuperscriptBox["\[Omega]", "2"]}], ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7aedf61a-353c-4cfc-b1ff-673f7afd6402"],
 ".\n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"Var", "(", "\[Omega]", ")"}], 
      SuperscriptBox["\[Omega]", "2"]], "\[TildeTilde]", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SubscriptBox["D", "\[Theta]"]}], 
       RowBox[{
        SuperscriptBox["\[Omega]", "2"], "N", " ", "\[CapitalDelta]t"}]], "+", 
      FractionBox[
       RowBox[{"12", " ", "R"}], 
       RowBox[{
        SuperscriptBox["\[Omega]", "2"], 
        SuperscriptBox["N", "3"], 
        SuperscriptBox["\[CapitalDelta]t", "2"]}]]}]}], "=", 
    RowBox[{
     FractionBox["2", 
      RowBox[{"N", " ", 
       OverscriptBox["\[CapitalDelta]t", "_"]}]], "+", 
     FractionBox[
      RowBox[{"12", 
       OverscriptBox["R", "_"]}], 
      RowBox[{
       SuperscriptBox["N", "3"], 
       SuperscriptBox[
        OverscriptBox["\[CapitalDelta]t", "_"], "2"]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a7da1ad-afd4-4b8f-8ac4-a68ace969d12"],
 "\n\nwhere  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalDelta]t", "_"], "=", 
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], 
     RowBox[{"\[CapitalDelta]t", "/", 
      SubscriptBox["D", "\[Theta]"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9079ee48-493c-4d67-a964-91d3b533adf7"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["R", "_"], "=", 
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], 
     RowBox[{"R", " ", "/", 
      SubsuperscriptBox["D", "\[Theta]", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5f091d23-3418-4b9c-8ebd-41b7716b1daf"],
 ", and ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "609f37e0-5763-446b-8f83-c66b5770dd36"],
 " are dimensionless parameters."
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.9810504949870157`*^9, 3.981050745202136*^9}, {
   3.981050782585465*^9, 3.981050848997167*^9}, {3.981050884189321*^9, 
   3.981051171710443*^9}, {3.981051426534028*^9, 3.981051441577277*^9}, {
   3.981095444016842*^9, 3.9810955930777397`*^9}, 3.981095623890576*^9, {
   3.981095691858994*^9, 3.9810958605990057`*^9}, {3.981113313234717*^9, 
   3.981113313733786*^9}},ExpressionUUID->"792239df-ce9b-49a9-9da0-\
4400a337a9a5"],

Cell[TextData[{
 "Physically, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[CapitalDelta]t", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "141f6409-6edb-48bb-a2ee-add7198632f2"],
 " is the time step relative to the drift-diffusion time.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", " ", 
    FormBox[
     OverscriptBox["\[CapitalDelta]t", "_"],
     TraditionalForm]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84db9c63-ceeb-4b73-b8ce-e1e1c57495f0"],
 " is the total time scaled by the drift-diffusion time.  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["R", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "749b6357-2ade-4c3c-9440-2002259907c9"],
 " measures the noise variance relative to the drift-diffusion phase."
}], "Text",
 CellChangeTimes->{{3.981095865196599*^9, 3.981095922284503*^9}, {
  3.981095957441209*^9, 
  3.981095997188034*^9}},ExpressionUUID->"cea6c4d2-178f-4a2f-9301-\
f811b559e07d"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s fix ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e15f9df9-2e1f-4557-952f-04d3c2338963"],
 " (e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "1000"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9f3d1361-40f4-4c74-af56-c36e39c5e4dd"],
 ") and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["R", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "90518800-ef04-4c96-ae4e-c17c8d157f63"],
 ", and vary ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalDelta]t", "_"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "15f30360-31b9-4600-a68b-f46fafcc7cbb"],
 " about the cross over point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{
      OverscriptBox["\[CapitalDelta]t", "_"], " "}], "c"], "=", 
    RowBox[{"6", " ", 
     RowBox[{
      OverscriptBox["R", "_"], "/", 
      SuperscriptBox["N", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4b2d20f7-8d66-4fc8-8510-c02b067c2a61"],
 ".   For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalDelta]t", "_"], " ", "\[LessLess]", 
    SubscriptBox[
     RowBox[{
      OverscriptBox["\[CapitalDelta]t", "_"], " "}], "c"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd46a67a-b9d4-4f4e-99bd-df996a8aebde"],
 ", the noise controls the frequency variance, which corresponds to the limit \
as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", "\[Theta]"], "\[RightArrow]", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c9255f3b-a7f4-42f3-9d57-975287b02f1e"],
 ".   In dimensional units, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["D", "\[Theta]"], "N", " ", "\[CapitalDelta]t"}], 
    "\[LessLess]", 
    FractionBox[
     RowBox[{"6", " ", "R"}], "N"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0bb8258c-73b3-4966-a903-90d5ab5050d7"],
 "\n\n\t"
}], "Text",
 CellChangeTimes->{{3.981096093817868*^9, 3.981096162550304*^9}, {
  3.98109620843445*^9, 
  3.98109635115232*^9}},ExpressionUUID->"e582435f-7aeb-4fb8-8338-\
4eda1282a5c3"],

Cell[TextData[{
 " We want to vary ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CapitalDelta]t", "_"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98bc616d-48d0-4bab-8e5a-e6c422995ba6"],
 " from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{
      OverscriptBox["\[CapitalDelta]t", "_"], " "}], "min"], "=", 
    RowBox[{"\[Gamma]", " ", 
     SubscriptBox[
      RowBox[{
       OverscriptBox["\[CapitalDelta]t", "_"], " "}], "c"]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9248c460-9c1a-45e9-bec9-a5748bb19279"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{
      OverscriptBox["\[CapitalDelta]t", "_"], " "}], "max"], "=", 
    RowBox[{
     SuperscriptBox["\[Gamma]", 
      RowBox[{"-", "1"}]], 
     SubscriptBox[
      RowBox[{
       OverscriptBox["\[CapitalDelta]t", "_"], " "}], "c"]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9642af04-94a8-4e22-a7b9-ea16790f8ec9"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "\[LessLess]", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cbb6c148-9ba1-415d-95ef-75dfa071bb0f"],
 " to establish the scaling relationships.  What should we choose for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["R", "_"], "=", 
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], 
     RowBox[{"R", " ", "/", 
      SubsuperscriptBox["D", "\[Theta]", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14530727-a882-4b2b-a10d-36289e916bd1"],
 "?  "
}], "Text",
 CellChangeTimes->{{3.981051174965411*^9, 3.981051401909696*^9}, {
   3.9810514805889797`*^9, 3.981051632584347*^9}, {3.981051692488935*^9, 
