Cell[TextData[{
 "The increments are normally distributed\n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]y", "k"], "=", 
    RowBox[{
     SubscriptBox["\[CapitalDelta]\[Theta]", "k"], "=", 
     RowBox[{
      SubscriptBox["\[Theta]", 
       RowBox[{"k", "+", "1"}]], "-", 
      SubscriptBox["\[Theta]", "k"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd9ca64b-f837-419c-9f51-2eb5414e5cd1"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "1"}], ",", 
    RowBox[{"N", "-", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ea44f47-31eb-4b67-b527-cdd8e43b8f11"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]\[Theta]", "k"], "\[Tilde]", 
    RowBox[{"\[ScriptCapitalN]", "(", 
     RowBox[{
      RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ",", "Q"}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3d63b62c-b6e6-41cd-bc20-3bee94293fcc"],
 "\n\nwith ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "=", 
    RowBox[{"2", " ", 
     SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "03a0b47c-0c10-4c8d-bc46-88487b54c67b"],
 "."
}], "Text",
 CellChangeTimes->{{3.981019095380465*^9, 
  3.981019237309162*^9}},ExpressionUUID->"7b84de7f-f89f-463a-8f8f-\
4133e3cb1ffd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{
      SubscriptBox["y", 
       RowBox[{"1", ":", "N"}]], "|", "\[Lambda]"}], ")"}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"k", "=", "1"}], 
      RowBox[{"N", "-", "1"}]], 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"2", " ", 
         SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]]], 
      RowBox[{"exp", "(", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", 
             RowBox[{"k", "+", "1"}]], "-", 
            SubscriptBox["y", "k"], "-", 
            RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], "2"], 
         RowBox[{"4", " ", 
          SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]]}], ")"}]}]}]}],
    TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e6d1b8d-11f8-48b4-8b76-68adf1ed1495"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptL]", "c"], "(", 
     RowBox[{"\[Lambda]", ";", "y"}], ")"}], "=", 
    RowBox[{"constant", "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"N", "-", "1"}], ")"}], "ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "N"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]y", "k"], "-", 
          RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], 
        "2"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99c56964-7359-41da-86a7-fce4404a3689"]
}], "Text",
 CellChangeTimes->{{3.9810192783692083`*^9, 3.98101937179228*^9}, {
  3.981019411707995*^9, 
  3.981019512462181*^9}},ExpressionUUID->"d6ceeb33-1d97-4bab-b986-\
97f8f744e85b"],

Cell[TextData[{
 "The log posterior is \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"L", "(", "\[Lambda]", ")"}], "=", 
    RowBox[{"constant", "-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Omega]", "-", 
         SubscriptBox["\[Mu]", "\[Omega]"]}], ")"}], "2"], 
      RowBox[{"2", 
       SubsuperscriptBox["\[Sigma]", "\[Omega]", "2"]}]], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Alpha]", "D"], "+", "1"}], ")"}], "ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], "-", 
     FractionBox[
      SubscriptBox["\[Beta]", "D"], 
      SubscriptBox["D", "\[Theta]"]], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"N", "-", "1"}], ")"}], "ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], 
        RowBox[{"N", "-", "1"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]y", "k"], "-", 
          RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}]}], ")"}], 
        "2"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "386d0cfe-64e3-4e00-b0b9-a0d933ac0b89"]
}], "Text",
 CellChangeTimes->{{3.981019533448579*^9, 3.981019625229834*^9}, {
  3.981019766037175*^9, 
  3.981019766113254*^9}},ExpressionUUID->"1f0b3438-7922-4196-97b3-\
f9acf8883c72"],

Cell[TextData[{
 "Laplace approximation for ",
 Cell[BoxData[
  FormBox["\[Omega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "badfe653-a593-468c-a2d8-ed2812e5b364"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ln", " ", 
    SubscriptBox["D", "\[Theta]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "94f3073d-fb2f-4b39-b687-fca59d489a3e"],
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"L", "(", "\[Lambda]", ")"}], "=", 
    RowBox[{"constant", "-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Omega]", "-", 
         SubscriptBox["\[Mu]", "\[Omega]"]}], ")"}], "2"], 
      RowBox[{"2", 
       SubsuperscriptBox["\[Sigma]", "\[Omega]", "2"]}]], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Alpha]", "D"], "+", "1"}], ")"}], "ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], "-", 
     FractionBox[
      SubscriptBox["\[Beta]", "D"], 
      SubscriptBox["D", "\[Theta]"]], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"N", "-", "1"}], ")"}], "ln", " ", 
      SubscriptBox["D", "\[Theta]"]}], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", " ", 
        SubscriptBox["D", "\[Theta]"], "\[CapitalDelta]t"}]], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["S", "0"], "-", 
        RowBox[{"2", "\[Omega]", " ", "\[CapitalDelta]t", " ", 
         SubscriptBox["S", "1"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"N", "-", "1"}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Omega]", " ", "\[CapitalDelta]t"}], ")"}], "2"]}]}], 
       ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cb57657c-d514-4c2c-a56d-ccdca5a1dc12"],
 "\n\nwhere  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "0"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], 
      RowBox[{"N", "-", "1"}]], 
     SubsuperscriptBox["\[CapitalDelta]y", "k", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53f867e0-9cd4-43c1-bcd1-9764c0b18274"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], 
      RowBox[{"N", "-", "1"}]], 
     SubscriptBox["\[CapitalDelta]y", "k"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f418e09-c132-4635-aebc-c15ac70bd8fa"]
}], "Text",
